# SMTP Outgoing Mail Server Configuration (Nodemailer)
# Copy this file to a new file named '.env' and populate with your credentials.

# SMTP Server Address (e.g. smtp.gmail.com for Gmail, smtp.mailgun.org for Mailgun)
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Username (usually your email address)
SMTP_USER=example@gmail.com

# Password (for Gmail, this MUST be an App Password, NOT your regular password!)
# Generate one here: https://myaccount.google.com/apppasswords
SMTP_PASS="denw bhue njws powu"

# Recipient Email Address (where contact emails should be sent)
# If left blank, emails will be sent to the SMTP_USER address above.
RECIPIENT_EMAIL=your-recipient-email@gmail.com
